#!/usr/bin/env python3

# Hook for validating commit messages for Krama
# Checks for
#   1. Empty message
#   2. An empty line after the subject
#   3. The subject's line length
#   4. For ordinary commits, the structure and then the types and scopes against
#      COMMITS.md's tables (copied here, manual sync)
#   5. For merge commits (MERGE_HEAD) available, verfiy only one branch is being
#      merged (as stated in COMMITS.md), check the label against the 3 merge
#      patterns and that the label matches the branch name (or any one of htem
#      in case multiple branches point to the same hash)

import os
import re
import subprocess
import sys
from collections import Counter

RED = "\033[31m"
YELLOW = "\033[33m"
RESET = "\033[0m"

if not sys.stderr.isatty() or os.getenv("NO_COLOR"):
    RED = ""
    YELLOW = ""
    RESET = ""


# Assumes git config i18n.commitEncoding is unset
with open(sys.argv[1], "r", encoding="UTF-8") as f:
    lines = f.readlines()

filtered = [line.rstrip() for line in lines]

# Mirror git's behaviour - stripping '#' lines when an editor ran (GIT_EDITOR is not ':')
if os.getenv("GIT_EDITOR") != ":":
    filtered = [line.rstrip() for line in lines if not line.startswith("#")]

while filtered and not filtered[0]:
    _ = filtered.pop(0)

if not filtered:
    sys.exit(f"{RED}[MsgError]{RESET} Empty message")

if len(filtered) > 1 and filtered[1]:
    sys.exit(f"{RED}[FmtError]{RESET} An empty line is required after the subject line")

subject = filtered[0]

if len(subject) > 72:
    sys.exit(f"{RED}[FmtError]{RESET} Subject line limited to 72 columns, got {len(subject)}")

if len(subject) > 50:
    print(
        f"{YELLOW}[FmtWarn]{RESET} Recommended to keep subject within 50 columns, got {len(subject)}",
        file=sys.stderr,
    )

command = "git rev-parse -q --verify MERGE_HEAD"
proc = subprocess.run(command.split(" "), stdout=subprocess.DEVNULL, check=False)


# For a "first pass" check if the ordinary commit subject matches the pattern
# structurally. Does not validate type and scope count, those are checked
# separately as they're both fixed sets and it allows for better error reporting
#
# Examples
# ---------
# For valid subjects:
#     foo(bar,baz,car): something    -- <type> followed by N <scope>s
#     foo: something                 -- <type> followed by no <scope>s
#
# For invalid subjects:
#     foo bar                        -- No <type> or <scope>
REGEX_ORDINARY = r"^(\w+)(\(\w+(,\w+)*\))?: (\S.*)?[^.,:;?!]$"

# The merge commit subject structure for milestone track e.g., - m1/arena
REGEX_MERGE_GENERAL = r"^m[0-9]+/[a-z0-9-]+(,[a-z0-9-]+)?: (\S.*)?[^.,:;?!]$"

# The merge commit subject structure for learn track e.g., learn/git/hooks
REGEX_MERGE_LEARN = r"^learn/[a-z0-9-]+/[a-z0-9-]+: (\S.*)?[^.,:;?!]$"

# The merge commit subject structure for tool track e.g., tool/commit-msg
REGEX_MERGE_TOOL = r"^tool/[a-z0-9-]+: (\S.*)?[^.,:;?!]$"


if proc.returncode == 1:
    regex = re.compile(REGEX_ORDINARY)
    structure_match = regex.fullmatch(subject)
    if structure_match is None:
        sys.exit(
            f"{RED}[PatternError]{RESET} For ordinary commits, expected pattern for subject:\n"
            + "\t<type>(<scope>): content\n\n"
            + "Examples:\n"
            + "---------\n"
            + "  * fix(lex): add missing keywords to table\n"
            + "  * test(lex,parse): validate fail cases\n\n"
            + "Note:\n"
            + "-----\n"
            + "  * <scope>s are comma separated with no spaces in between\n"
            + "  * Subject should not end in a terminating punctuation [. , : ; ? !]\n\n"
            + "See COMMITS.md for more info"
        )

    type_in_commit = structure_match.group(1)
    if type_in_commit == "wip":
        sys.exit(0)

    valid_types = [
        "feat",
        "fix",
        "refactor",
        "test",
        "docs",
        "build",
        "perf",
        "chore",
        "learn",
    ]
    err_msg: list[str] = []
    if type_in_commit not in valid_types:
        err_msg.append(
            f"{RED}[TypeError]{RESET} Invalid type '{type_in_commit}' for commit\n"
            + f"Valid types are {','.join(valid_types)}"
        )

    scopes_in_commit = structure_match.group(2)
    if scopes_in_commit is not None:
        if type_in_commit in ["build", "learn"]:
            # A direct `exit` is ok here because the <type> is valid so `err_msg`
            # is always `[]` at this point and there is nothing to accumulate
            sys.exit(f"{RED}[ScopeError]{RESET} <type> '{type_in_commit}' accepts no scope")

        # <scope> has shape (lex,parse), only 2 scopes allowed, comma separated
        # and no sapce in between
        scopes = scopes_in_commit[1 : len(scopes_in_commit) - 1].split(",")
        nscopes = len(scopes)
        valid_scopes = [
            "lex",
            "parse",
            "ast",
            "check",
            "codegen",
            "interp",
            "rt",
            "arena",
            "cli",
            "diag",
            "test",
            "spec",
        ]
        scope_errors: list[str] = []
        if nscopes > 2:
            scope_errors.append(f"  * Too many scopes. Got {nscopes}, expected at most 2")

        invalid = [s for s in scopes if s not in valid_scopes]
        if invalid:
            scope_errors.append(
                f"  * Invalid scope(s) found - {', '.join(invalid)}\n"
                + f"    Valid scopes are {', '.join(valid_scopes)}"
            )

        valid = [s for s in scopes if s in valid_scopes]
        if type_in_commit == "test" and "test" in valid:
            scope_errors.append(
                f"  * <scope> 'test' is redundant for <type> '{type_in_commit}'; test(test,...)"
            )

        dupes = [(k, v) for k, v in Counter(valid).items() if v > 1]
        if dupes:
            dupes = [f"{s}({n})" for s, n in dupes]
            scope_errors.append(f"  * Duplicate scopes found: {', '.join(dupes)}")

        if scope_errors:
            scope_errors.insert(
                0,
                f"{RED}[ScopeError]{RESET} The following error(s) were identified in <scope>(s)",
            )
            err_msg.extend(scope_errors)

    if err_msg:
        err_msg.append("\nSee COMMITS.md for more info")
        sys.exit("\n".join(err_msg))

elif proc.returncode == 0:
    # Check in case multiple branches are being merged at once. MERGE_HEAD
    # stores each commit hash per line and `--points-at MERGE_HEAD` uses only
    # the first one. Checking the number of lines is enough since per COMMITS.md
    # only one branch may be merged at a time
    command = "git rev-parse --git-path MERGE_HEAD"
    proc = subprocess.run(command.split(" "), capture_output=True, check=False, text=True)
    if proc.returncode:
        sys.exit(
            f"{RED}[UnhandledError]{RESET} Command exited with code {proc.returncode}\n"
            + f"Executed: {command}"
        )

    path_merge_head = proc.stdout.strip()
    try:
        with open(path_merge_head, "r") as f:
            if len(f.readlines()) > 1:
                sys.exit(f"{RED}[MultiMergeError]{RESET} Merge one branch at a time")
    except OSError as e:
        sys.exit(f"Error opening MERGE_HEAD\n{e}")

    patterns = [
        REGEX_MERGE_GENERAL,
        REGEX_MERGE_LEARN,
        REGEX_MERGE_TOOL,
    ]
    for pattern in patterns:
        regex = re.compile(pattern)
        structure_match = regex.fullmatch(subject)
        if structure_match is not None:
            break
    else:
        sys.exit(
            f"{RED}[PatternError]{RESET} For merge commits, expected one of the following patterns for subject:\n"
            + "\tm<N>/<branch-name>: content          # For merges related towards kramac milestone number `N`\n"
            + "\tlearn/<topic>/<subtopic>: content    # For merges related to learning (ground-up)\n"
            + "\ttool/<tool-name>: content            # Merges related to tool updates\n\n"
            + "Note:\n"
            + "-----\n"
            + "  * Subject should not end in a terminating punctuation [. , : ; ? !]\n\n"
            + "See COMMITS.md for more info\n"
        )

    # Check if the commit label (part before the first `:`) matches any one of
    # the branches pointing to the same commit hash. Given the multiple merge
    # check above, at this point there is only one commit hash in MERGE_HEAD so
    # the `points-at` use here is safe
    command = "git for-each-ref --points-at MERGE_HEAD --format=%(refname:short) refs/heads/"
    proc = subprocess.run(command.split(" "), capture_output=True, check=False, text=True)
    if proc.returncode:
        sys.exit(
            f"{RED}[UnhandledError]{RESET} Command exited with code {proc.returncode}\n"
            + f"Executed: {command}"
        )

    branch_name = proc.stdout.strip().split("\n")
    if branch_name == [""]:
        sys.exit(f"{RED}[BranchError]{RESET} No branch points to the commit being merged")

    commit_label = structure_match[0].split(":")[0]
    if commit_label not in branch_name:
        sys.exit(
            f"{RED}[LabelError]{RESET} Commit label should match branch name."
            + f" Got {commit_label}, expected one of {', '.join(branch_name)}"
        )

else:
    sys.exit(
        f"{RED}[UnhandledError]{RESET} Exit code {proc.returncode} while running:\n\t{command}"
    )
