import ...

fn main(): i32 {
        const x: i32 = 10;
        const y: i32 = read_from_stdin();

        let z: i32 = if (x > y) {
          give x - y;
        } else {
          give y - x;
        };

        if (z > 3) {
                @print("Krama +++\n");
        } else if (z > 1) {
                @print("Krama +\n");
        } else {
                @print("No Krama\n");
        }
        return 0;
}
