import ...

fn main(): i32 {
        let x: i32 = 10;
        let y: i32 = 5;

        let z: i32 = 0;

        set z = x + y;
        @print("{x} + {y} = {z}");

        set z = x - y;
        @print("{x} - {y} = {z}");

        set z = x * y;
        @print("{x} * {y} = {z}");

        set z = x // y;
        @print("{x} // {y} = {z}");

        set z = x % y;
        @print("{x} % {y} = {z}");

        set z = (-x) % y;
        @print("-{x} % {y} = {z}"); # remainder is positive

        @check({
                let p: u32 = 0;
                set p = x + y; # TypeError here, p is unsigned but x, y are signed ints
                set p = @cast(x + y, u32); # Warning here, signed -> unsigned conversion
        });

        return 0;
}
